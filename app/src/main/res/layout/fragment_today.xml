<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/previous_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/previous_day" android:text="‹"/>
        <TextView android:id="@+id/today_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textStyle="bold"/>
        <Button android:id="@+id/next_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/next_day" android:text="›"/>
    </LinearLayout>
    <TextView android:id="@+id/today_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"/>
    <TextView android:id="@+id/today_alert" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/holo_orange_dark" />
    <TextView android:id="@+id/today_category_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" />
    <Button android:id="@+id/today_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/add_activity"/>
    <TextView android:id="@+id/today_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:text="@string/today_empty"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/today_entries" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp" />
</LinearLayout>
