<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <Spinner android:id="@+id/weekly_period" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/weekly_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_select_categories"/>
    <RadioGroup android:id="@+id/weekly_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <RadioButton android:id="@+id/weekly_bars" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_bars" android:checked="true"/>
        <RadioButton android:id="@+id/weekly_deviation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/weekly_deviation"/>
    </RadioGroup>
    <TextView android:id="@+id/weekly_summary" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/weekly_zero" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weekly_zero_line" android:visibility="gone"/>
    <com.androidplot.xy.XYPlot android:id="@+id/weekly_chart" android:layout_width="match_parent" android:layout_height="210dp" android:contentDescription="@string/weekly_chart_description"/>
    <TextView android:id="@+id/weekly_chart_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp"/>
    <TextView android:id="@+id/weekly_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@android:color/holo_red_dark"/>
    <TextView android:id="@+id/weekly_detail_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weekly_detail_heading" android:textStyle="bold"/>
    <TextView android:id="@+id/weekly_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="5" android:ellipsize="end"/>
    <TextView android:id="@+id/weekly_table_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weekly_table_heading" android:textStyle="bold"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/weekly_table" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="@string/weekly_table_heading"/>
</LinearLayout>
